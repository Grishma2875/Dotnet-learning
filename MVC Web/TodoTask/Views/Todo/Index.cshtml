@model List<TodoApp.Models.Todo>

@{
    ViewData["Title"] = "Todo List";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Todo List</h2>

        <a asp-controller="Todo"
           asp-action="Create"
           class="btn btn-primary">
            Create New Task
        </a>

    </div>


    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No records found.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>Task Name</th>
                    <th>User Name</th>
                    <th>Description</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.Id</td>

                        <td>@item.TaskName</td>

                        <td>@item.UserName</td>
                        
                        <td>@(item.Description ?? "No Description")</td>

                        <td>

                            <a asp-controller="Todo"
                               asp-action="Edit"
                               asp-route-id="@item.Id">
                                Edit
                            </a>

                            <span> | </span>

                            <form asp-controller="Todo"
                                  asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  style="display:inline;">

                                <button type="submit"
                                        style="border:none;
                                    background:none;
                                    color:red;
                                    padding:0;">
                                    Delete
                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>