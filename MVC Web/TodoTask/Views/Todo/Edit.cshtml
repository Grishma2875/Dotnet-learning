@model TodoApp.Models.Todo

@{
    ViewData["Title"] = "Edit Task";
}

<div class="container mt-4">

    <h2>Edit Task</h2>

    <form asp-controller="Todo"
          asp-action="Edit"
          method="post">

        <input type="hidden"
               asp-for="Id" />


        <div class="mb-3">

            <label asp-for="TaskName"
                   class="form-label">
                Task Name
            </label>

            <input asp-for="TaskName"
                   class="form-control" />

            <span asp-validation-for="TaskName"
                  class="text-danger">
            </span>

        </div>
       
        
        <div class="mb-3">

            <label asp-for="UserName"
                   class="form-label">
                User Name
            </label>

            <input asp-for="UserName"
                   class="form-control" />

            <span asp-validation-for="UserName"
                  class="text-danger">
            </span>

        </div>


        <div class="mb-3">

            <label asp-for="Description"
                   class="form-label">
                Description
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"></textarea>

        </div>


        <button type="submit"
                class="btn btn-success">
            Update Task
        </button>

        <a asp-controller="Todo"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </form>

</div>