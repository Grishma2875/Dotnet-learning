@model TagHelpersDemo.Models.Employee;
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="container">
    <div class="row">
    <div class="col-sm-4">
        <form asp-action="Index" asp-controller="Home" method="post" class="d-grid">
            <label asp-for>Enter your Name: </label>
            <input asp-for="Name" placeholder="Enter Name"/>
            <br />  
            <br/>
            <select asp-for="Gender" class="form-control" asp-items="Html.GetEnumSelectList<Gender>()">
                <option value="">Select Gender</option>
            </select>
            <br />
            <input asp-for="Age" placeholder="Enter Age"/>
                <br />
                <br />
                <input asp-for="Designation" placeholder="Enter Designation" />
                <br />
                <br/>
                <input asp-for="Salary" placeholder="Enter salary" />
                <br />
                <br/>
                <label> 
                    Married
                </label>
                <div class="from-check">
                    <input asp-for="IsMarried" class="form-check-input" type="radio" id="flexRadioDefault1"/>
                    <label class="from-check-label" for="flexRadioDefault1">Yes</label>   
                 </div>
                <div class="from-check">
                    <input asp-for="IsMarried" class="form-check-input" type="radio" id="flexRadioDefault2"/>
                    <label class="from-check-label" for="flexRadioDefault2">no</label>   
                 </div>
                <input type="submit" value="Submit" class="btn btn-ot"/>
                 <textarea asp-for="Description" placeholder="Enter Description" class="form-control">
                </textarea>
        </form>
    </div>
    </div>
</div>


