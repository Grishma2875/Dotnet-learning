@model ViewModelASPCore6.Models.SchoolViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="container">
    @if (Model.myStudents.Any())
    {
        <h2>STUDENTD DATA</h2>
        <table class="table table-bordered table-dark table-hover table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>NAME</th>
                    <th>GENDER</th>
                    <th>CLASS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ietm in Model.myStudents)
                {
                    <tr>
                        <td>@ietm.Id</td>
                        <td>@ietm.Name</td>
                        <td>@ietm.Gender</td>
                        <td>@ietm.Standard</td>

                    </tr>
                }
            </tbody>

        </table>
    }
    else
    {
        <h2>No Students Found..</h2>
    }
    <br/>

     @if (Model.MyTeachers.Any())
    {
        <h2>TEACHERS DATA</h2>
        <table class="table table-bordered table-dark table-hover table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>NAME</th>
                    <th> Qualification</th>
                    <th>Salary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ietm in Model.MyTeachers)
                {
                    <tr>
                        <td>@ietm.Id</td>
                        <td>@ietm.Name</td>
                        <td>@ietm. Qualification</td>
                        <td>@ietm.Salary</td>

                    </tr>
                }
            </tbody>

        </table>
    }
    else
    {
        <h2>No Teachers Found..</h2>
    }
</div>
